# Set these in your shell or approved secret manager. The CLI does not load this file.
SQLSERVER_CONNECTION_STRING='Driver={ODBC Driver 18 for SQL Server};Server=tcp:sql.example.com,1433;Database=SalesforceReporting;UID=reviewer;PWD=REPLACE_ME;Encrypt=yes;TrustServerCertificate=no'
AZURE_OPENAI_ENDPOINT='https://your-resource.openai.azure.com/'
AZURE_OPENAI_DEPLOYMENT='your-chat-deployment'
AZURE_OPENAI_API_KEY='REPLACE_ME'
AZURE_OPENAI_API_VERSION='2024-10-21'

# Default for --ai. An explicit --ai-provider overrides this.
SQL_REVIEW_AI_PROVIDER='azure'

# OpenAI hosted API
OPENAI_API_KEY='REPLACE_ME'
OPENAI_MODEL='your-chat-model'

# OpenAI-compatible Chat Completions endpoint, for example a local Ollama server
SQL_REVIEW_AI_BASE_URL='http://127.0.0.1:11434/v1'
SQL_REVIEW_AI_MODEL='your-installed-chat-model'
# SQL_REVIEW_AI_API_KEY='REPLACE_ME_IF_ENDPOINT_REQUIRES_AUTH'

# Optional draft PR integration. Use the repository that owns the SQL source.
SQL_REVIEW_GITHUB_REPOSITORY='your-org/database-source'
SQL_REVIEW_GITHUB_BASE='main'
SQL_REVIEW_GITHUB_MODULES='{"dbo.usp_GetDeals":"procedures/usp_GetDeals.sql"}'
SQL_REVIEW_GITHUB_TOKEN='REPLACE_ME'
